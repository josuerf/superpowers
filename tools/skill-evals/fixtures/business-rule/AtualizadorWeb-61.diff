 	}
 
+	/**
+	 * Resolve o valor de teto aplicável ao participante do convênio RPC Genérico (Prevcom): se o participante valida contra o teto do RGPS, usa a maior faixa vigente da previdência geral; caso contrário, usa o teto customizado cadastrado no próprio participante. Retorna
+	 * {@code null} quando não há teto configurado (não deve ser aplicado limite).
+	 */
+	public static BigDecimal obterTetoParticipantePrevcom(Contexto contexto, SrhRegimePrevidenciaComplementarGenericoParticipanteModel participanteVinculado) {
+
+		if (participanteVinculado == null || participanteVinculado.getValidarTetoInss() == null)
+			return null;
+
+		if (TpSimNaoType.SIM.equals(participanteVinculado.getValidarTetoInss()))
+			return obterMaiorFaixaPrevidenciaVigente(contexto);
+
+		return participanteVinculado.getTeto();
+	}
+
+	/**
+	 * Regra de CONTRIBUIÇÃO do participante (fronteira INCLUSIVA — {@code base >= teto}): o participante já deve contribuir quando a base atinge exatamente o teto, não apenas quando o ultrapassa. Usado por {@code SrhPercentualRpcParticipanteFunction} para decidir SE a
+	 * contribuição do participante deve ser somada. Teto {@code null} significa ausência de restrição de teto configurada (cadastro permite {@code validarTetoInss=NAO} com {@code teto} em branco — ver {@code RegimePrevidenciaComplementarGenericoValidador}) — sem teto para
+	 * comparar, o participante é sempre elegível para contribuir, mantendo paridade com {@link #baseExcedeTetoParaLimitacao} (que também trata {@code null} como ausência de limite).
+	 */
+	public static boolean baseAtingiuOuUltrapassouTetoParaContribuicao(BigDecimal base, BigDecimal teto) {
+		return teto == null || (base != null && base.compareTo(teto) >= 0);
+	}
+
+	/**
+	 * Regra de LIMITAÇÃO de valor (fronteira EXCLUSIVA — {@code base > teto}): o valor da base só é capado no teto quando o excede estritamente; no ponto exato {@code base == teto} o valor calculado permanece intacto. Usado por {@code SrhValorBasePrevidenciaComplementarFunction}
+	 * para decidir SE o valor deve ser limitado ao teto. Teto {@code null} significa ausência de limite — nunca capa.
+	 */
+	public static boolean baseExcedeTetoParaLimitacao(BigDecimal base, BigDecimal teto) {
+		return teto != null && base != null && base.compareTo(teto) > 0;
+	}
+
 }
