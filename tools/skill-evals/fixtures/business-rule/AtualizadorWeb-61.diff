+import es.srh.business.calculo.function.diaria.codigosretirarbase.SrhCodigosDiariaRetirarBaseFunctionFactory;
+import es.srh.business.calculo.function.previdencia.SrhTratarVerbasLicencaMesUtil;
+import es.srh.business.calculo.function.util.Parametro;
+import es.srh.business.calculo.function.util.TpParamFuncaoCalculoType;
+import es.srh.business.calculo.function.verba.codigosincidentescomvalor.SrhCodigosIncidentesComValorFunction;
+import es.srh.business.calculo.function.verba.codigosincidentescomvalor.SrhCodigosIncidentesComValorFunctionFactory;
+import es.srh.business.calculo.util.CalculaVerbasIncidentes;
+import es.srh.business.calculo.util.SomaCodigosCalculados;
+import es.srh.business.calculo.util.VerbaCalculada;
+import es.srh.model.SrhPrevidenciaModel;
+import es.srh.model.SrhVerbaModel;
+import es.srh.model.pessoa.publica.SrhPessoaPublicaModel;
+import es.srh.types.TpPrevidenciaType;
+
+/**
+ * Pipeline compartilhado de apuração da base de incidência de previdência complementar
+ * (RPC Genérico/Prevcom) para 1 matrícula: recupera os códigos incidentes do agrupador,
+ * retira códigos de diária, trata verbas de licença (RGPS), acumula os códigos calculados
+ * e resolve o valor final via {@code SrhCodigosIncidentesComValorFunction}.
+ *
+ * Extraído de {@code SrhValorBasePrevidenciaComplementarFunction} e
+ * {@code SrhPercentualRpcParticipanteFunction}, que reproduziam o mesmo pipeline de forma
+ * praticamente idêntica. O chamador (subclasse de {@code SrhAbstractFunction}) é passado
+ * para que os itens de log/função calculados aqui sejam copiados para o resumo de cálculo
+ * do próprio chamador, preservando o comportamento original de rastreabilidade.
+ */
+public final class RpcGenericoApuracaoBaseUtil {
+
+	private RpcGenericoApuracaoBaseUtil() {
+	}
+
+	public static BigDecimal apurarBaseIncidencia(SrhAbstractFunction chamador, Contexto contexto, MatriculaCalc matricula, Integer codAgrupador) {
+
+		SrhPessoaPublicaModel pessoaPublica = matricula.getPessoaPublica();
+
+		List<MatriculaCalc> listMatricula = new MatriculasCalc(matricula).getAsListMatriculasCalc();
+
+		List<SrhVerbaModel> codigosIncidentes = new VerbasIncidentes(matricula.getVerbasPessoaPublica(), contexto.getIncidencias()).getVerbasIncidencias(codAgrupador);
+
+		SrhCodigosDiariaRetirarBaseFunction codigosDiariaRetirarBaseFunction = new SrhCodigosDiariaRetirarBaseFunctionFactory(contexto).comParametro(new Parametro(TpParamFuncaoCalculoType.LISTACODIGOS.name(), codigosIncidentes)).instanciar(listMatricula);
+		codigosDiariaRetirarBaseFunction.setRecuoBase(chamador.getRc().getRecuoBase());
+		List<SrhVerbaModel> codigosDiariaRetirarBase = codigosDiariaRetirarBaseFunction.calcular();
+		chamador.getRc().append(codigosDiariaRetirarBaseFunction);
+
+		List<SrhVerbaModel> codigosIncidentesBase = new ArrayList<>(codigosIncidentes);
+		codigosIncidentesBase.removeAll(codigosDiariaRetirarBase);
+
+		SrhPrevidenciaModel previdencia = pessoaPublica.getPrevidencia();
+		SrhTratarVerbasLicencaMesUtil util = new SrhTratarVerbasLicencaMesUtil(contexto, chamador.getRc());
+		List<SrhVerbaModel> listaVerbasParaRecalcular = new ArrayList<>();
+		if (TpPrevidenciaType.RGPS.equals(previdencia.getTpPrevidencia())) {
+			listaVerbasParaRecalcular = util.recuperarVerbasLicencaMesParaRecalcular(codigosIncidentesBase);
+			codigosIncidentesBase.removeAll(listaVerbasParaRecalcular);
+		}
+
+		codigosIncidentesBase.removeAll(util.recuperarVerbasLicencaAno(codigosIncidentesBase));
+
+		CalculaVerbasIncidentes acumula = new CalculaVerbasIncidentes(chamador.getRc().getRecuoBase());
+		List<VerbaCalculada> codigosCalculados = acumula.calcular(codigosIncidentesBase, contexto, listMatricula, listMatricula);
+		chamador.getRc().append(acumula);
+
+		if (TpPrevidenciaType.RGPS.equals(previdencia.getTpPrevidencia())) {
+			codigosCalculados.addAll(util.recalculaVerbasLicencaMes(listaVerbasParaRecalcular, listMatricula));
+		}
+
+		SrhCodigosIncidentesComValorFunction codigosIncidentesPrevComValorFunction = new SrhCodigosIncidentesComValorFunctionFactory(contexto).comParametro(new Parametro(TpParamFuncaoCalculoType.LISTACODIGOS.name(), codigosCalculados)).instanciar();
+		codigosIncidentesPrevComValorFunction.setRecuoBase(chamador.getRc().getRecuoBase());
+		List<VerbaCalculada> codigosIncidentesPrevComValor = codigosIncidentesPrevComValorFunction.calcular();
+		chamador.getRc().append(codigosIncidentesPrevComValorFunction);
+		chamador.copiarItensFunction(codigosIncidentesPrevComValorFunction);
+
+		return new SomaCodigosCalculados(codigosIncidentesPrevComValor).somarCodigos();
+	}
+
+}
